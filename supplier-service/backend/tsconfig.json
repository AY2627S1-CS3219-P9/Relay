{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@relay/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@relay/contracts/*": [
        "../../packages/contracts/src/*"
      ],
      "@relay/backend-auth-middleware": [
        "../../user-service/packages/backend-auth-middleware/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
