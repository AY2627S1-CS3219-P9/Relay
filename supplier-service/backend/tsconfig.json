{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@relay/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@relay/contracts/*": [
        "../../packages/contracts/src/*"
      ],
      "@relay/user-auth-jwt-verify": [
        "../../user-service/user-auth-jwt-verify/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
