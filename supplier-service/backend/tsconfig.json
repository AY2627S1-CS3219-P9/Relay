{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@relay/contracts": ["../../packages/contracts/src/index.ts"],
      "@relay/contracts/*": ["../../packages/contracts/src/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["../node_modules", "../../dist"]
}
