{
  "name": "@relay/supplier-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsc --noEmit && tsx --watch src/app.ts",
    "build": "tsc --noEmit && esbuild ././src/app.ts --bundle --packages=external --platform=node --format=esm --outdir=./dist",
    "start": "node ./dist/app.js",
    "test": "node --import tsx tests/supplier-filter.test.ts && node --import tsx tests/supplier.service.test.ts && node --import tsx test/admin-access.test.ts"
  },
  "dependencies": {
    "@relay/contracts": "*",
    "express": "^5.1.0",
    "pg": "^8.11.3",
    "@relay/user-auth-backend-middleware": "*",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.3",
    "esbuild": "^0.24.0",
    "tsx": "^4.7.0",
    "typescript": "~6.0.2"
  }
}
