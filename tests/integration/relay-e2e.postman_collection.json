    {
      "name": "requester final balance",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/credit",
        "header": [
          {
            "key": "Cookie",
            "value": "{{requesterCookie}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const b=pm.response.code===200?pm.response.json():null;",
              "const attempts=Number(pm.environment.get(pm.info.requestName+'Attempts')||0);",
              "if((!b||b.availableCredit!==90||b.reserveCredit!==0)&&attempts<20){pm.environment.set(pm.info.requestName+'Attempts',attempts+1);pm.execution.setNextRequest(pm.info.requestName);}else{",
              "pm.environment.unset(pm.info.requestName+'Attempts');",
              "pm.test('balance available',()=>pm.response.to.have.status(200));",
              "if(b){pm.test('balance belongs to user',()=>pm.expect(b.userId).to.eql(pm.environment.get('requesterSub')));pm.test('credit settled',()=>pm.expect(b.availableCredit).to.eql(90));pm.test('nothing reserved',()=>pm.expect(b.reserveCredit).to.eql(0));}",
              "}"
            ]
          }
        }
      ]
