            ]
          }
        }
      ]
    },
    {
      "name": "requester balance",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/credit",
        "header": [
          {
            "key": "Cookie",
            "value": "{{requesterCookie}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const attempts=Number(pm.environment.get(pm.info.requestName+'Attempts')||0);",
              "if (pm.response.code===404 && attempts<20) { pm.environment.set(pm.info.requestName+'Attempts',attempts+1); pm.execution.setNextRequest(pm.info.requestName); } else { pm.test('balance allocated',()=>pm.response.to.have.status(200)); pm.environment.unset(pm.info.requestName+'Attempts'); }",
              "if(pm.response.code===200){const b=pm.response.json();pm.test('initial credit belongs to user',()=>pm.expect(b.userId).to.eql(pm.environment.get('requesterSub')));pm.test('initial 100 credits',()=>pm.expect(b.availableCredit).to.eql(100));}"
            ]
          }
        }
      ]
    },
