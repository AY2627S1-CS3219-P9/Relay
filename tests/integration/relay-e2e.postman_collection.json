{
  "info": {
    "name": "Relay errand and credit end-to-end",
    "description": "Run in order against the full Compose stack. Verification codes come from Floci SES. Credit events are asynchronous. In Postman Collection Runner set a 1000 ms request delay so allocation and completion events can settle.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "requester register",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/user/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{requesterEmail}}\",\"password\":\"{{password}}\",\"passwordConfirmation\":\"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const s=Date.now().toString(36)+Math.random().toString(36).slice(2,7);",
              "pm.environment.set('requesterEmail','relay-requester-'+s+'@example.com');",
              "pm.environment.set('requesterName','relayrequester'+s);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(201);"
            ]
          }
        }
      ]
    },
    {
      "name": "requester verification code",
      "request": {
        "method": "GET",
        "url": "{{flociUrl}}/_aws/ses",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);",
              "const m=pm.response.json().messages.find(x=>x.Destination.ToAddresses.includes(pm.environment.get('requesterEmail')));",
              "pm.expect(m).to.exist;",
              "pm.environment.set('requesterCode',m.Body.text_part.match(/\\b\\d{6}\\b/)[0]);"
            ]
          }
        }
      ]
    },
    {
      "name": "requester verify and login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/user/auth/verification/confirm-and-login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{requesterEmail}}\",\"password\":\"{{password}}\",\"code\":\"{{requesterCode}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.environment.set('requesterSub',pm.response.json().data.user.subject);",
              "pm.environment.set('requesterCookie',pm.response.headers.get('Set-Cookie').split(';')[0]);"
            ]
          }
        }
      ]
    },
    {
      "name": "requester create profile",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/user/me",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{requesterCookie}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{requesterName}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);"
            ]
          }
        }
      ]
    },
    {
      "name": "requester session",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/user/session",
