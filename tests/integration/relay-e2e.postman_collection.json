    {
      "name": "requester balance after drop",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/credit",
        "header": [
          {
            "key": "Cookie",
            "value": "{{requesterCookie}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('balance available',()=>pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test('drop keeps 10 reserved',()=>pm.expect(b.reserveCredit).to.eql(10));",
              "pm.test('available credit remains 80',()=>pm.expect(b.availableCredit).to.eql(80));"
            ]
          }
        }
      ]
    },
