{
  "info": {
    "name": "Relay super admin and supplier role workflow",
    "description": "Run folders in order against local Docker Compose and Floci. The first request generates two fresh user emails. The bootstrap super admin values match .env.development. Promotion and demotion revoke the affected user's sessions. This workflow leaves two users and one supplier in the local database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create two users and profiles",
      "item": [
        {
          "name": "01 Register admin candidate",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const s=Date.now().toString(36)+Math.random().toString(36).slice(2,7);",
                  "pm.collectionVariables.set('adminEmail',`relay-admin-${s}@example.com`);",
                  "pm.collectionVariables.set('normalEmail',`relay-user-${s}@example.com`);",
                  "pm.collectionVariables.set('adminUsername',`relayAdmin${s}`);",
                  "pm.collectionVariables.set('normalUsername',`relayUser${s}`);",
                  "pm.collectionVariables.set('supplierName',`Relay Postman ${s}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
                  "pm.test('verification required',()=>pm.expect(pm.response.json().data.verificationRequired).to.eql(true));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookieJar": true
          },
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/user/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\",\"passwordConfirmation\":\"{{adminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "02 Read admin verification code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "const a=pm.response.json().messages||[]; const m=a.find(x=>(x.Destination?.ToAddresses||[]).includes(pm.collectionVariables.get('adminEmail')));",
                  "pm.test('email found',()=>pm.expect(m).to.exist);",
                  "const match=m?.Body?.text_part?.match(/\\b\\d{6}\\b/);",
                  "pm.test('code found',()=>pm.expect(match).to.exist);",
                  "if(match)pm.collectionVariables.set('adminCode',match[0]);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookieJar": true
          },
          "request": {
            "method": "GET",
            "url": "{{flociUrl}}/_aws/ses",
            "header": []
          }
        },
        {
          "name": "03 Verify admin candidate and sign in",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "pm.test('initial user role',()=>pm.expect(pm.response.json().data.user.role).to.eql('user'));",
                  "const c=pm.response.headers.get('Set-Cookie'); pm.test('session cookie',()=>pm.expect(c).to.include('relay_session=')); if(c)pm.collectionVariables.set('adminCookie',c.split(';')[0]);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookieJar": true
          },
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/user/auth/verification/confirm-and-login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\",\"code\":\"{{adminCode}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "04 Create admin candidate profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "pm.test('profile created',()=>pm.expect(pm.response.json().data.profileCreated).to.eql(true));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookieJar": true
          },
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/user/me",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "{{adminCookie}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{adminUsername}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
