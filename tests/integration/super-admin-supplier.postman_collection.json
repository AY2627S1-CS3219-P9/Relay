                  "pm.test('email found',()=>pm.expect(m).to.exist);",
                  "const match=m?.Body?.text_part?.match(/\\b\\d{6}\\b/);",
                  "pm.test('code found',()=>pm.expect(match).to.exist);",
                  "if(match)pm.collectionVariables.set('normalCode',match[0]);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookieJar": true
          },
          "request": {
            "method": "GET",
            "url": "{{flociUrl}}/_aws/ses",
            "header": []
          }
        },
        {
          "name": "07 Verify normal user and sign in",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "const c=pm.response.headers.get('Set-Cookie'); pm.test('session cookie',()=>pm.expect(c).to.include('relay_session=')); if(c)pm.collectionVariables.set('normalCookie',c.split(';')[0]);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookieJar": true
          },
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/user/auth/verification/confirm-and-login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{normalEmail}}\",\"password\":\"{{normalPassword}}\",\"code\":\"{{normalCode}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "08 Create normal user profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "pm.test('profile created',()=>pm.expect(pm.response.json().data.profileCreated).to.eql(true));"
                ]
