{
  "info": {
    "name": "Relay new-user allocation e2e",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Sign up new user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/user/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{testEmail}}\",\"password\":\"{{testPassword}}\",\"passwordConfirmation\":\"{{testPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const suffix = Date.now().toString(36) + Math.random().toString(36).slice(2, 7);",
              "pm.environment.set(\u0027testEmail\u0027, `relay-${suffix}@example.com`);",
              "pm.environment.set(\u0027testUsername\u0027, `relay${suffix}`);",
              "pm.environment.set(\u0027testPassword\u0027, \u0027Test1234!\u0027);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\u0027registration accepted\u0027, () =\u003e pm.response.to.have.status(201));",
              "pm.test(\u0027verification required\u0027, () =\u003e pm.expect(pm.response.json().data.verificationRequired).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read verification code from Floci SES",
      "request": {
        "method": "GET",
        "url": "{{flociUrl}}/_aws/ses"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\u0027SES mailbox available\u0027, () =\u003e pm.response.to.have.status(200));",
              "const message = pm.response.json().messages.find((item) =\u003e item.Destination.ToAddresses.includes(pm.environment.get(\u0027testEmail\u0027)));",
              "pm.test(\u0027verification email found\u0027, () =\u003e pm.expect(message).to.exist);",
              "const match = message \u0026\u0026 message.Body.text_part.match(/\\b\\d{6}\\b/);",
              "pm.test(\u0027verification code found\u0027, () =\u003e pm.expect(match).to.exist);",
              "if (match) pm.environment.set(\u0027verificationCode\u0027, match[0]);"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify email and sign in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/user/auth/verification/confirm-and-login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{testEmail}}\",\"password\":\"{{testPassword}}\",\"code\":\"{{verificationCode}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\u0027verification accepted\u0027, () =\u003e pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\u0027profile is not yet created\u0027, () =\u003e pm.expect(body.data.user.profileCreated).to.eql(false));",
              "pm.environment.set(\u0027cognitoSub\u0027, body.data.user.subject);",
              "const cookie = pm.response.headers.get(\u0027Set-Cookie\u0027);",
              "pm.test(\u0027session cookie returned\u0027, () =\u003e pm.expect(cookie).to.include(\u0027relay_session=\u0027));",
              "if (cookie) pm.environment.set(\u0027sessionCookie\u0027, cookie.split(\u0027;\u0027)[0]);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create user profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{sessionCookie}}"
          }
        ],
        "url": "{{baseUrl}}/api/user/me",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{testUsername}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\u0027profile created\u0027, () =\u003e pm.response.to.have.status(200));",
              "pm.test(\u0027created username matches\u0027, () =\u003e pm.expect(pm.response.json().data.username).to.eql(pm.environment.get(\u0027testUsername\u0027)));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update existing profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{sessionCookie}}"
          }
        ],
        "url": "{{baseUrl}}/api/user/me",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{testUsername}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\u0027profile update accepted\u0027, () =\u003e pm.response.to.have.status(200));",
              "pm.test(\u0027same user profile\u0027, () =\u003e pm.expect(pm.response.json().data.username).to.eql(pm.environment.get(\u0027testUsername\u0027)));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "flociUrl",
      "value": "http://localhost:4566"
    }
  ]
}
