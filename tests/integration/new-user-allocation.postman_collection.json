{
  "info": {
    "name": "Relay new-user allocation e2e",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Sign up new user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{testEmail}}\",\"password\":\"{{testPassword}}\",\"passwordConfirmation\":\"{{testPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const suffix = Date.now().toString(36) + Math.random().toString(36).slice(2, 7);",
              "pm.environment.set('testEmail', `relay-${suffix}@example.com`);",
              "pm.environment.set('testUsername', `relay${suffix}`);",
              "pm.environment.set('testPassword', 'Test1234!');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('registration accepted', () => pm.response.to.have.status(201));",
              "pm.test('verification required', () => pm.expect(pm.response.json().data.verificationRequired).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read verification code from Floci SES",
      "request": {
        "method": "GET",
        "url": "{{flociUrl}}/_aws/ses"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('SES mailbox available', () => pm.response.to.have.status(200));",
              "const message = pm.response.json().messages.find((item) => item.Destination.ToAddresses.includes(pm.environment.get('testEmail')));",
              "pm.test('verification email found', () => pm.expect(message).to.exist);",
              "const match = message && message.Body.text_part.match(/\\b\\d{6}\\b/);",
              "pm.test('verification code found', () => pm.expect(match).to.exist);",
              "if (match) pm.environment.set('verificationCode', match[0]);"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify email and sign in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/verification/confirm-and-login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{testEmail}}\",\"password\":\"{{testPassword}}\",\"code\":\"{{verificationCode}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('verification accepted', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('profile is not yet created', () => pm.expect(body.data.user.profileCreated).to.eql(false));",
              "pm.environment.set('cognitoSub', body.data.user.subject);",
              "const cookie = pm.response.headers.all().filter(h=>h.key.toLowerCase()==='set-cookie').map(h=>h.value.split(';')[0]).filter(x=>x.startsWith('relay_access=')||x.startsWith('relay_id=')).join('; ');",
              "pm.test('session cookie returned', () => pm.expect(cookie).to.include('relay_access='));",
              "if (cookie) pm.environment.set('sessionCookie', cookie);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create user profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{sessionCookie}}"
          }
        ],
        "url": "{{baseUrl}}/api/user/me",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{testUsername}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('profile created', () => pm.response.to.have.status(200));",
              "pm.test('created username matches', () => pm.expect(pm.response.json().data.username).to.eql(pm.environment.get('testUsername')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update existing profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "{{sessionCookie}}"
          }
        ],
        "url": "{{baseUrl}}/api/user/me",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{testUsername}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('profile update accepted', () => pm.response.to.have.status(200));",
              "pm.test('same user profile', () => pm.expect(pm.response.json().data.username).to.eql(pm.environment.get('testUsername')));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "flociUrl",
      "value": "http://localhost:4566"
    }
  ]
}
