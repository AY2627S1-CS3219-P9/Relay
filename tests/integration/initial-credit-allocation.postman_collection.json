{
  "info": {
    "name": "Relay initial credit allocation flow",
    "description": "Run folders in order against local Docker Compose and Floci. A verified user without a profile receives 403 FORBIDDEN from Credit Service. Profile creation publishes UserRegistered asynchronously; the final GET retries until the initial 100 credits appear or 15 attempts fail. Each full run creates a fresh user.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register, verify, and check balance before profile",
      "item": [
        {
          "name": "01 Register new user",
          "protocolProfileBehavior": {
            "disableCookieJar": true
          },
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{testEmail}}\",\"password\":\"{{testPassword}}\",\"passwordConfirmation\":\"{{testPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const suffix=Date.now().toString(36)+Math.random().toString(36).slice(2,7);",
                  "pm.collectionVariables.set('testEmail',`relay-credit-${suffix}@example.com`);",
                  "pm.collectionVariables.set('testUsername',`relayCredit${suffix}`);",
                  "pm.collectionVariables.set('balanceAttempts','0');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('registration accepted',()=>pm.response.to.have.status(201));",
                  "pm.test('verification required',()=>pm.expect(pm.response.json().data.verificationRequired).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Read OTP from Floci SES",
          "protocolProfileBehavior": {
            "disableCookieJar": true
          },
          "request": {
            "method": "GET",
            "url": "{{flociUrl}}/_aws/ses",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('SES mailbox available',()=>pm.response.to.have.status(200));",
                  "const message=(pm.response.json().messages||[]).find(item=>(item.Destination?.ToAddresses||[]).includes(pm.collectionVariables.get('testEmail')));",
                  "pm.test('verification email found',()=>pm.expect(message).to.exist);",
                  "const match=message?.Body?.text_part?.match(/\\b\\d{6}\\b/);",
                  "pm.test('six-digit OTP found',()=>pm.expect(match).to.exist);",
                  "if(match)pm.collectionVariables.set('verificationCode',match[0]);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Submit OTP and log in",
          "protocolProfileBehavior": {
            "disableCookieJar": true
          },
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/verification/confirm-and-login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{testEmail}}\",\"password\":\"{{testPassword}}\",\"code\":\"{{verificationCode}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('verification accepted',()=>pm.response.to.have.status(200));",
                  "pm.test('profile not created',()=>pm.expect(pm.response.json().data.user.profileCreated).to.eql(false));",
                  "pm.collectionVariables.set('cognitoSub',pm.response.json().data.user.subject);",
                  "const cookie=pm.response.headers.all().filter(h=>h.key.toLowerCase()==='set-cookie').map(h=>h.value.split(';')[0]).filter(x=>x.startsWith('relay_access=')||x.startsWith('relay_id=')).join('; ');",
                  "pm.test('session cookie returned',()=>pm.expect(cookie).to.include('relay_access='));",
                  "if(cookie)pm.collectionVariables.set('sessionCookie',cookie);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Credit balance unavailable before profile",
          "protocolProfileBehavior": {
            "disableCookieJar": true
          },
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/credit",
            "header": [
              {
                "key": "Cookie",
                "value": "{{sessionCookie}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('profile required',()=>pm.response.to.have.status(403));",
                  "pm.test('forbidden code',()=>pm.expect(pm.response.json().code).to.eql('FORBIDDEN'));",
                  "pm.test('message says profile required',()=>pm.expect(pm.response.json().message).to.match(/profile/i));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Create profile and verify initial credit",
      "item": [
        {
          "name": "01 Create profile",
          "protocolProfileBehavior": {
            "disableCookieJar": true
          },
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/user/me",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "{{sessionCookie}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{testUsername}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('profile created',()=>pm.response.to.have.status(200));",
                  "pm.test('username matches',()=>pm.expect(pm.response.json().data.username).to.eql(pm.collectionVariables.get('testUsername')));",
                  "pm.test('profile complete',()=>pm.expect(pm.response.json().data.profileCreated).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Credit balance allocated",
          "protocolProfileBehavior": {
            "disableCookieJar": true
          },
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/credit",
            "header": [
              {
                "key": "Cookie",
                "value": "{{sessionCookie}}"
              }
            ]
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if(Number(pm.collectionVariables.get('balanceAttempts')||0)>0)setTimeout(()=>{},1000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const attempt=Number(pm.collectionVariables.get('balanceAttempts')||0)+1;",
                  "if(pm.response.code===404 && attempt<15){",
                  "  pm.collectionVariables.set('balanceAttempts',String(attempt));",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "}else{",
                  "  pm.collectionVariables.unset('balanceAttempts');",
                  "  pm.test('balance allocated',()=>pm.response.to.have.status(200));",
                  "  if(pm.response.code===200){",
                  "    const b=pm.response.json();",
                  "    pm.test('belongs to new user',()=>pm.expect(b.userId).to.eql(pm.collectionVariables.get('cognitoSub')));",
                  "    pm.test('100 available credits',()=>pm.expect(b.availableCredit).to.eql(100));",
                  "    pm.test('zero reserved credits',()=>pm.expect(b.reserveCredit).to.eql(0));",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "flociUrl",
      "value": "http://localhost:4566",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "relay-credit@example.com",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "Test1234!",
      "type": "secret"
    },
    {
      "key": "testUsername",
      "value": "relayCreditUser",
      "type": "string"
    },
    {
      "key": "verificationCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionCookie",
      "value": "",
      "type": "string"
    },
    {
      "key": "cognitoSub",
      "value": "",
      "type": "string"
    },
    {
      "key": "balanceAttempts",
      "value": "0",
      "type": "string"
    }
  ]
}
