# Copy this file to .env.local and replace every placeholder locally.
# .env.local is ignored by Git. Do not put real credentials in this example file.

# The Docker k6 container reaches the local Compose host through this address.
BASE_URL=http://host.docker.internal:8080

# Browse smoke account (may be the requester account below).
LOAD_TEST_USER_EMAIL=relay-load-requester@example.com
LOAD_TEST_USER_PASSWORD=replace-with-a-unique-local-password

# Lifecycle requires two separate, verified accounts with completed profiles and credit records.
LOAD_TEST_REQUESTER_EMAIL=relay-load-requester@example.com
LOAD_TEST_REQUESTER_PASSWORD=replace-with-a-unique-local-password
LOAD_TEST_COURIER_EMAIL=relay-load-courier@example.com
LOAD_TEST_COURIER_PASSWORD=replace-with-a-different-local-password
LOAD_TEST_COURIER_B_EMAIL=relay-load-courier-b@example.com
LOAD_TEST_COURIER_B_PASSWORD=replace-with-a-third-local-password

# The provisioner selects this supplier and discovers one of its offered service types.
LOAD_TEST_SUPPLIER_NAME=Octobox
LOAD_TEST_SUPPLIER_ID=replace-with-active-supplier-id
LOAD_TEST_SERVICE_TYPE=0
LOAD_TEST_CREDIT_AMOUNT=1

# Keep test data small while validating the setup.
LIFECYCLE_VUS=1
LIFECYCLE_ITERATIONS=1
LOAD_TEST_CLEANUP=true
