# Copy this file to .env.local and replace every placeholder locally.
# .env.local is ignored by Git. Do not put real credentials in this example file.

# The Docker k6 container reaches the local Compose host through this address.
BASE_URL=http://host.docker.internal:8080

# For AWS provisioning, use provision-aws-test-data.mjs with BASE_URL set to
# the deployed ALB and AWS_PROFILE/AWS_REGION/COGNITO_USER_POOL_ID configured.

# Browse smoke account (may be the requester account below).
LOAD_TEST_USER_EMAIL=relay-load-requester@example.com
LOAD_TEST_USER_PASSWORD=replace-with-a-unique-local-password

# Lifecycle requires two separate, verified accounts with completed profiles and credit records.
LOAD_TEST_REQUESTER_EMAIL=relay-load-requester@example.com
LOAD_TEST_REQUESTER_PASSWORD=replace-with-a-unique-local-password
LOAD_TEST_COURIER_EMAIL=relay-load-courier@example.com
LOAD_TEST_COURIER_PASSWORD=replace-with-a-different-local-password
LOAD_TEST_COURIER_B_EMAIL=relay-load-courier-b@example.com
LOAD_TEST_COURIER_B_PASSWORD=replace-with-a-third-local-password

# The provisioner selects this supplier and discovers one of its offered service types.
LOAD_TEST_SUPPLIER_NAME=Octobox
LOAD_TEST_SUPPLIER_ID=replace-with-active-supplier-id
LOAD_TEST_SERVICE_TYPE=0
LOAD_TEST_CREDIT_AMOUNT=1
LOAD_TEST_FIXTURE_CREDIT_AMOUNT=1

# Smoke and lifecycle scenarios.
SMOKE_VUS=1
SMOKE_DURATION=30s
LIFECYCLE_VUS=1
LIFECYCLE_ITERATIONS=1
LIFECYCLE_MAX_DURATION=2m
SETTLEMENT_TIMEOUT_SECONDS=30
SETTLEMENT_POLL_SECONDS=1
LOAD_TEST_CLEANUP=true

# Errand read NFR baseline. Increase gradually after validating the baseline.
NFR_START_VUS=10
NFR_TARGET_VUS=100
NFR_RAMP_DURATION=1m
NFR_HOLD_DURATION=5m
NFR_RAMP_DOWN_DURATION=1m
NFR_THINK_TIME=1
NFR_P95_LIMIT_MS=250

# User Service authentication NFR. The default is 500 login requests per minute.
NFR_AUTH_RATE_PER_MIN=500
NFR_AUTH_DURATION=5m
NFR_AUTH_PREALLOCATED_VUS=50
NFR_AUTH_MAX_VUS=100
NFR_AUTH_P95_LIMIT_MS=500

# Supplier query NFR.
NFR_SUPPLIER_RATE_PER_SEC=50
NFR_SUPPLIER_DURATION=5m
NFR_SUPPLIER_PREALLOCATED_VUS=50
NFR_SUPPLIER_MAX_VUS=100
NFR_SUPPLIER_P95_LIMIT_MS=200

# Credit balance/guard observation NFR. Keep the project VU limit in mind.
NFR_CREDIT_RATE_PER_SEC=10
NFR_CREDIT_DURATION=1m
NFR_CREDIT_PREALLOCATED_VUS=20
NFR_CREDIT_MAX_VUS=100
NFR_CREDIT_P95_LIMIT_MS=200

# Credit estimation AI NFR. The default stays below the 20-request limit for
# each of the three provisioned users during one continuous run.
NFR_ESTIMATION_RATE_PER_MIN=15
NFR_ESTIMATION_DURATION=3m
NFR_ESTIMATION_PREALLOCATED_VUS=5
NFR_ESTIMATION_MAX_VUS=20
NFR_ESTIMATION_P95_LIMIT_MS=3500

# Credit estimation per-user rate-limit boundary test. This expected limit must
# match AI_RATE_LIMIT_REQUESTS_PER_MINUTE on the service under test.
NFR_ESTIMATION_PER_USER_LIMIT=20
NFR_ESTIMATION_RATE_LIMIT_REQUESTS=25
NFR_ESTIMATION_RATE_LIMIT_VUS=5
NFR_ESTIMATION_RATE_LIMIT_MAX_DURATION=1m
NFR_ESTIMATION_RATE_LIMIT_REJECTION_P95_MS=500

# Credit estimation AI NFR. The default stays below the 20-request limit for
# each of the three provisioned users during one continuous run.
NFR_ESTIMATION_RATE_PER_MIN=15
NFR_ESTIMATION_DURATION=3m
NFR_ESTIMATION_PREALLOCATED_VUS=5
NFR_ESTIMATION_MAX_VUS=20
NFR_ESTIMATION_P95_LIMIT_MS=3500

# Credit estimation per-user rate-limit boundary test. This expected limit must
# match AI_RATE_LIMIT_REQUESTS_PER_MINUTE on the service under test.
NFR_ESTIMATION_PER_USER_LIMIT=20
NFR_ESTIMATION_RATE_LIMIT_REQUESTS=25
NFR_ESTIMATION_RATE_LIMIT_VUS=5
NFR_ESTIMATION_RATE_LIMIT_MAX_DURATION=1m
NFR_ESTIMATION_RATE_LIMIT_REJECTION_P95_MS=500

# Mixed Errand workload. The 30/min write rate provides enough samples for
NFR_MIXED_READ_TARGET_VUS=90
NFR_MIXED_READ_HOLD_DURATION=2m
NFR_MIXED_WRITE_RATE_PER_MIN=30
NFR_MIXED_WRITE_DURATION=2m
NFR_MIXED_THINK_TIME=1
NFR_MIXED_READ_P95_LIMIT_MS=250
NFR_MIXED_CREATE_P95_LIMIT_MS=250
NFR_MIXED_CANCEL_P95_LIMIT_MS=150
