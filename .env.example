# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ---- PostgreSQL ------------------------------------------------
# Supplier Service Backend (NOT CURRENTLY USED BY YAML file)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=relay
DB_USER=postgres
DB_PASSWORD=postgres

# ---- Redis Configuration ---------------------------------------
# Used by: Credit Estimation Service (distributed rate limiting)
REDIS_URL=redis://redis:6379
REDIS_MEMORY_LIMIT=512M
REDIS_MEMORY_RESERVATION=256M
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ---- Service Tokens -------------------------------------------
CREDIT_ESTIMATION_SERVICE_TOKEN=local-internal-estimation-service-token
INTERNAL_SUPPLIER_SERVICE_TOKEN=local-internal-supplier-service-token
CREDIT_SERVICE_INTERNAL_TOKEN=local-internal-credit-service-token

# ---- Kafka event topics -------------------------------------
KAFKA_TOPIC_USER_EVENTS=user-events
KAFKA_TOPIC_USER_DLQ=user-events-dlq
KAFKA_TOPIC_ERRAND_EVENTS=errand-events
KAFKA_TOPIC_ERRAND_DLQ=errand-events-dlq

