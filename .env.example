# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ---- PostgreSQL ------------------------------------------------
# Supplier Service Backend
DB_HOST=localhost
DB_PORT=5433
DB_NAME=relay
DB_USER=postgres
DB_PASSWORD=postgres

# ... Add more variables as needed
# ---- Kafka event topics -------------------------------------
KAFKA_TOPIC_USER_REGISTERED=relay.user.registered
KAFKA_TOPIC_USER_DELETED=relay.user.deleted
KAFKA_TOPIC_ERRAND_CONFIRMED=relay.errand.confirmed
KAFKA_TOPIC_ERRAND_CANCELLED=relay.errand.cancelled
KAFKA_TOPIC_ERRAND_EXPIRED=relay.errand.expired
