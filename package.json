{
  "name": "relay",
  "private": true,
  "workspaces": [
    "host",
    "supplier-service/frontend",
    "user-service/frontend",
    "user-service/backend",
    "order-service/frontend",
    "credit-service/frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev --workspace @relay/host\" \"npm run dev --workspace @relay/supplier-frontend\" \"npm run dev --workspace @relay/user-frontend\" \"npm run dev --workspace @relay/order-frontend\" \"npm run dev --workspace @relay/credit-frontend\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test:workspaces && npm run test:services",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:services": "npm run test:services:frontend",
    "test:services:frontend": "node --test tests/frontend/*.test.mjs",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.8"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
