NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://relay:relay@localhost:5432/relay?schema=public

MOCK_JWT_SECRET=replace-with-a-local-development-secret
MOCK_JWT_ISSUER=relay-user-service
MOCK_JWT_AUDIENCE=relay-user-frontend

S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=relay-user-profile-images
S3_FORCE_PATH_STYLE=true
SESSION_COOKIE_NAME=relay_session
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_SECURE=false
INTERNAL_USER_SERVICE_TOKEN=local-internal-user-service-token
