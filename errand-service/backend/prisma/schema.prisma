generator client {
  provider = "prisma-client-js"
  output   = "../../../packages/errand-prisma/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ErrandStatus {
  OPEN
  ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
  EXPIRED
  CONFIRMED
  DELETED
}

model Errand {
  id String @id @default(uuid()) @db.Uuid

  // Cognito identity keys. These are intentionally not foreign keys because
  // identity ownership is managed by the User Service.
  requesterSub String
  courierSub   String?

  // Supplier Service identifier. Supplier data is owned by another service.
  supplierId String

  pickupLat          Float
  pickupLng          Float
  pickupBuildingName String
  pickupFloorNumber  Int

  targetLat          Float
  targetLng          Float
  targetBuildingName String
  targetFloorNumber  Int

  name                 String
  supplierName         String
  serviceType          Int
  deliveryDescription  String
  deliveryInstructions String?

  creditAmount Int
  status       ErrandStatus @default(OPEN)
  expiresAt    DateTime
  confirmationDeadline DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([requesterSub])
  @@index([courierSub])
  @@index([supplierId])
  @@index([status, expiresAt])
  @@map("errands")
}

model PendingErrand {
  id           String   @id @db.Uuid
  requesterSub String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("pending_errands")
}

model ErrandEventOutbox {
  id          String    @id @db.Uuid
  eventType   String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt, createdAt])
  @@map("errand_event_outbox")
}
