# Optional overrides for deploy/deploy.sh. Generated Cognito and S3 values are written automatically.
# KUBERNETES_VERSION=1.37
IMAGE_TAG=latest
# COGNITO_AWS_ENDPOINT=https://cognito-idp.ap-southeast-1.amazonaws.com
# Required to initialize the AWS AI secret on first deployment.
# Once initialized, edit the AWS secret to rotate credentials.
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=
# AI_ENDPOINT=
# AI_TEMPERATURE=0
# AI_MAX_TOKENS=1000
# AI_ESTIMATION_TIMEOUT_MS=3000
# AI_RATE_LIMIT_REQUESTS_PER_MINUTE=20
# AI_GLOBAL_RATE_LIMIT_REQUESTS_PER_MINUTE=300

# Optional production ConfigMap overrides (validated by the deployer).
# USER_API_TIMEOUT=5000
# SUPPLIER_SERVICE_TIMEOUT_MS=5000
# ERRAND_SERVICE_TIMEOUT_MS=5000
# KAFKA_PARTITION_COUNT=12
# SUPPLIER_TIMEZONE=Asia/Singapore
# Internal service tokens are generated by CloudFormation in Secrets Manager.
# Never put production service tokens in this file.
