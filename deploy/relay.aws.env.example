# Required by scripts/deploy-eks.sh. Copy to relay.aws.env; it is ignored by Git.
KUBERNETES_VERSION=REPLACE_WITH_A_SUPPORTED_EKS_VERSION
IMAGE_TAG=latest
COGNITO_ISSUER=REPLACE_WITH_COGNITO_ISSUER
COGNITO_JWKS_URI=REPLACE_WITH_COGNITO_JWKS_URI
COGNITO_CLIENT_ID=REPLACE_WITH_COGNITO_APP_CLIENT_ID
COGNITO_USER_POOL_ID=REPLACE_WITH_COGNITO_USER_POOL_ID
# Optional: defaults to the normal regional Cognito API endpoint.
# COGNITO_AWS_ENDPOINT=https://cognito-idp.REPLACE_REGION.amazonaws.com
S3_ENDPOINT=https://s3.REPLACE_REGION.amazonaws.com
S3_PUBLIC_ENDPOINT=https://s3.REPLACE_REGION.amazonaws.com
S3_ACCESS_KEY_ID=REPLACE_WITH_IAM_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_IAM_SECRET
S3_BUCKET=REPLACE_WITH_PROFILE_IMAGE_BUCKET
